; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wayfarer Framework"
config/version="1.0.0"
run/main_scene="uid://sdee1s7k23kv"
config/features=PackedStringArray("4.4")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://ycau40de6hnt"
boot_splash/minimum_display_time=3000

[autoload]

GameState="*res://autoload/wf_game_state.gd"
SettingsManager="*res://autoload/wf_settings_manager.gd"
LocalizationManager="*res://autoload/wf_localization_manager.gd"
AudioManager="*res://autoload/wf_audio_manager.gd"
InputManager="*res://autoload/wf_input_manager.gd"
SceneLoader="*res://autoload/wf_scene_loader.gd"

[editor]

run/main_run_args="--dev"

[editor_plugins]

enabled=PackedStringArray("res://addons/translation_tool/plugin.cfg")

